[Unit]
Description=Backup CourtLab SQLite

[Service]
Type=oneshot
User=courtlab
Group=courtlab
EnvironmentFile=/etc/courtlab/api.env
ExecStart=/usr/bin/python3 /opt/courtlab/server/backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/courtlab
